#!/bin/bash
# Refuse any push that isn't explicitly to personal realvivianqiao/tamagotchi.
set -euo pipefail

allowed='github.com/realvivianqiao/tamagotchi'
remote_name="${1:-}"
remote_url="${2:-}"

if [[ -z "$remote_url" ]]; then
  remote_url="$(git remote get-url "$remote_name" 2>/dev/null || true)"
fi

if [[ -z "$remote_url" ]]; then
  echo "pre-push: no url — aborting" >&2
  exit 1
fi

if echo "$remote_url" | grep -qiE 'nx1|_nx1|nx1\.com'; then
  echo "pre-push: REFUSING — remote looks NX1-related:" >&2
  echo "  $remote_url" >&2
  exit 1
fi

if ! echo "$remote_url" | grep -Fq "$allowed"; then
  echo "pre-push: REFUSING — remote is not $allowed:" >&2
  echo "  $remote_url" >&2
  exit 1
fi

echo "pre-push: ok → $remote_url"
